meta {
  name: Metrics summary — 30-day overview
  type: http
  seq: 1
}

get {
  url: https://eulerity-hackathon.appspot.com/v1/metrics-summary
  body: none
  auth: none
}

tests {
  test("returns the four supported platforms", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("period");
    expect(res.getBody()).to.have.property("previousPeriod");
    expect(res.getBody()).to.have.property("meta");
    expect(res.getBody()).to.have.property("google");
    expect(res.getBody()).to.have.property("linkedin");
    expect(res.getBody().meta).to.have.property("facebook");
    expect(res.getBody().meta).to.have.property("instagram");
  });
}
