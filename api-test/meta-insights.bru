meta {
  name: Meta insights — 14-day comparison
  type: http
  seq: 2
}

get {
  url: https://eulerity-hackathon.appspot.com/v1/metrics-insights?network=meta&startDate=2026-06-27&endDate=2026-07-10
  body: none
  auth: none
}

tests {
  test("returns platform-keyed Meta metrics and a comparison period", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().network).to.equal("meta");
    expect(res.getBody().totals).to.have.property("facebook");
    expect(res.getBody().totals).to.have.property("instagram");
    expect(res.getBody().dailyData.facebook).to.be.an("array");
    expect(res.getBody().previousTotals.facebook).to.have.property("conversions");
  });
}
