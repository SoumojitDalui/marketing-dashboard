meta {
  name: LinkedIn insights — 14-day comparison
  type: http
  seq: 4
}

get {
  url: https://eulerity-hackathon.appspot.com/v1/metrics-insights?network=linkedin&startDate=2026-06-27&endDate=2026-07-10
  body: none
  auth: none
}

tests {
  test("returns flat LinkedIn metrics with engagement fields", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().network).to.equal("linkedin");
    expect(res.getBody().totals).to.have.property("follows");
    expect(res.getBody().dailyData).to.be.an("array");
    expect(res.getBody().dailyData[0]).to.have.property("shares");
  });
}
