meta {
  name: Validation — invalid date format
  type: http
  seq: 8
}

get {
  url: https://eulerity-hackathon.appspot.com/v1/metrics-insights?network=google&startDate=06-27-2026&endDate=2026-07-10
  body: none
  auth: none
}

tests {
  test("returns INVALID_DATE_FORMAT for a non-ISO date", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("INVALID_DATE_FORMAT");
    expect(res.getBody()).to.have.property("message");
  });
}
