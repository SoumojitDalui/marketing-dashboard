meta {
  name: Google insights — 14-day comparison
  type: http
  seq: 3
}

get {
  url: https://eulerity-hackathon.appspot.com/v1/metrics-insights?network=google&startDate=2026-06-27&endDate=2026-07-10
  body: none
  auth: none
}

tests {
  test("returns flat Google metrics with cost per conversion", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().network).to.equal("google");
    expect(res.getBody().totals).to.have.property("costPerConversion");
    expect(res.getBody().dailyData).to.be.an("array");
    expect(res.getBody().previousTotals).to.have.property("spend");
  });
}
